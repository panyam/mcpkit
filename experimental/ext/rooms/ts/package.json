{
  "name": "@panyam/mcpkit-rooms",
  "version": "0.8.9",
  "description": "Page side of the mcpkit room bridge: offer WebMCP-shaped tools to agents through a massrelay room",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panyam/mcpkit.git",
    "directory": "experimental/ext/rooms/ts"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:pack": "node scripts/check-pack.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@panyam/massrelay": "^0.3.1",
    "@panyam/servicekit-client": "^0.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
