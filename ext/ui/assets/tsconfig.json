  "compilerOptions": {
    "target": "ES2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "declaration": false,
    "removeComments": false,
    "sourceMap": false,
    "outDir": "."
  },
  "include": ["mcp-app-bridge.ts", "mcp-app-extras.ts"],
  "exclude": ["mcp-app-bridge.js", "mcp-app-bridge.d.ts", "mcp-app-extras.js", "mcp-app-extras.d.ts"]
}
