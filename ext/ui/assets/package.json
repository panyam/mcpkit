{
  "name": "@mcpkit/app-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic postMessage bridge for MCP Apps (iframe side)",
  "scripts": {
    "build": "esbuild mcp-app-bridge.ts --bundle --format=iife --target=es2020 --outfile=mcp-app-bridge.js && esbuild mcp-app-extras.ts --bundle --format=esm --target=es2020 --outfile=mcp-app-extras.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
