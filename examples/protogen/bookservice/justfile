# bookservice example justfile

# Generate Go code from proto files (gen/ is replaced only if buf succeeds)
generate:
    bash ../../../experimental/ext/protogen/scripts/generate.sh .

# Run the example MCP server
run:
    go run .

# Run e2e tests
test:
    go test -count=1 -timeout 30s -v .

# Remove generated artifacts
clean:
    rm -rf gen

# Show this help
help:
    @just --list

# Default: generate, test, and run
all: generate test run
