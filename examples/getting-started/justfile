# examples/getting-started — the minimal quickstart used by the Get Started
# guide. Not a demokit walkthrough (see README); just a server + client pair.

# Start the minimal MCP server on :8787
server:
    go run ./server

# Run the minimal MCP client against the server
client:
    go run ./client

# Build both binaries
build:
    go build ./...

# Run the scenario natively and under js/wasm (needs node)
test:
    make -C .. test-getting-started

# Build the server for the browser into web/dist/
web:
    bash ../../scripts/build-example-wasm.sh . ./server

# Build the browser page and serve it on http://localhost:8788/
serve-web:
    bash ../../scripts/serve-example-wasm.sh . ./server 8788

default: server
