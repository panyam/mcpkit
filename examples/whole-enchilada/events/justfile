# Every variable below is exported, so a recipe stays one dispatch line instead
# of re-listing ten NAME='{{NAME}}' pairs before the script it calls. RUNNER is
# what lets a shared script print `just <recipe>` in its usage message.
set export := true

RUNNER := 'just'
N := env('N', '3')
TENANT := env('TENANT', '')
TOKEN := env('TOKEN', '')
EVENT := env('EVENT', 'chat.message')
TEXT := env('TEXT', 'hello from `just inject`')
USER := env('USER', '')
PASSWORD := env('PASSWORD', '')
KEYCLOAK_PORT := env('KEYCLOAK_PORT', '8180')
KEYCLOAK_HOST := env('KEYCLOAK_HOST', 'http://localhost:' + KEYCLOAK_PORT)
ONEAUTH_VERSION := env('ONEAUTH_VERSION', 'v0.1.36')
AUTH_INTROSPECTION_URLS := env('AUTH_INTROSPECTION_URLS', 'http://keycloak:8080/realms/asgard/protocol/openid-connect/token/introspect,http://keycloak:8080/realms/babylon/protocol/openid-connect/token/introspect,http://keycloak:8080/realms/camelot/protocol/openid-connect/token/introspect')
REGISTRY := env('REGISTRY', 'ghcr.io/panyam')
IMAGE_TAG := env('IMAGE_TAG', 'latest')
EVENT_SERVER_IMAGE := REGISTRY + '/mcpkit-event-server:' + IMAGE_TAG
KEYCLOAK_IMAGE := REGISTRY + '/mcpkit-events-keycloak:' + IMAGE_TAG
ONEAUTH := 'oneauth'
DEMO_CLIENT_ID := env('DEMO_CLIENT_ID', 'mcp-events-poller')
DEMO_CLIENT_SECRET := env('DEMO_CLIENT_SECRET', 'mcpkit-demo-secret-DEMO-ONLY')
STACK := 'events-stack.yaml'
DEV_OVERLAY := 'compose.dev.yaml'
COMPOSE := 'docker compose -f ' + STACK + ' -f ' + DEV_OVERLAY
COMPOSE_PUBLIC := 'docker compose -f ' + STACK
OBSERVABILITY_COMPOSE := '../../../docker/observability/docker-compose.yml'
HOSTS_NAMES := 'nginx.whole-enchilada event-server.whole-enchilada event-server-1.whole-enchilada event-server-2.whole-enchilada event-server-3.whole-enchilada'
REPLICAS := env('REPLICAS', '1')
NAME := env('NAME', 'discord.message')
CHANNELS := env('CHANNELS', '')
SOURCE := env('SOURCE', '')
EVERY := env('EVERY', '')
TENANTS := env('TENANTS', 'asgard,babylon,camelot')
TTL_MS := env('TTL_MS', '')
REPLY_STATUS := env('REPLY_STATUS', '')
EXIT_AFTER := env('EXIT_AFTER', '')
USERNAME := env('USERNAME', '')
START_CURSOR := env('START_CURSOR', '')
BUILD := env('BUILD', '')

# The tenant letter -> realm mapping lives in scripts/common.sh now. It used to
# exist twice, as this regex chain and as the Makefile's nested $(filter ...).

# Show this help.
help:
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / { printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2 }' {{justfile()}}

# Regenerate docker-compose.yaml + nginx/nginx.conf for N event-servers.
gen-compose:
	go -C tools/gen-compose run . -n={{N}} -out=../.. -image={{EVENT_SERVER_IMAGE}} -keycloak-image={{KEYCLOAK_IMAGE}}

# --- standalone stack (events-stack.yaml) ---
# The recipes above build event-server from your checkout. These drive the
# single self-contained compose published for people without this repo.

# Bring up the standalone events-stack.yaml (pulls published images; anonymous auth).
stack-up:
	{{COMPOSE_PUBLIC}} up -d --wait --wait-timeout 180
	@echo "standalone stack up; nginx on http://localhost:9090 — try: just stack-smoke"

# Same, plus Keycloak and the three demo realms, with the replicas ON token introspection.
stack-up-auth:
	KEYCLOAK_PORT={{KEYCLOAK_PORT}} OAUTH_ISSUER_BASE="{{KEYCLOAK_HOST}}" \
	OAUTH_INTROSPECTION_URLS="{{AUTH_INTROSPECTION_URLS}}" \
		{{COMPOSE_PUBLIC}} --profile auth up -d --wait --wait-timeout 300
	@echo "standalone stack up WITH auth; Keycloak on http://localhost:8180"
	@echo "verify the replicas actually reject anonymous callers: just stack-smoke-auth"

# Assert the auth stack REJECTS an anonymous subscriber (the check stack-smoke cannot make).
stack-smoke-auth:
	EXPECT_AUTH=1 ./scripts/smoke-stack.sh

# Tear the standalone stack down, including its named volumes.
stack-down:
	{{COMPOSE_PUBLIC}} --profile auth down -v

# Verify the DEV stack (what `just up` brings up). Auth is on there, so this asserts anonymous callers are refused.
smoke:
	EXPECT_AUTH=1 ./scripts/smoke-stack.sh

# Verify the PUBLISHED stack in its default anonymous posture (`just stack-up`). Not for `just up` — that stack has auth on.
stack-smoke:
	./scripts/smoke-stack.sh

# Tail logs from the standalone stack.
stack-logs:
	{{COMPOSE}} logs -f --tail=100

# Build the published images locally (does not push).
images:
	docker build -t {{EVENT_SERVER_IMAGE}} -f event-server/Dockerfile ../../..
	docker build -t {{KEYCLOAK_IMAGE}} ../../../docker/backends/keycloak

# Build and push the published images. Requires `docker login ghcr.io`.
images-push: images
	docker push {{EVENT_SERVER_IMAGE}}
	docker push {{KEYCLOAK_IMAGE}}

# Build all binaries locally (without Docker). push-server stays a reference for the production-shape HTTPSource pattern (run via `go -C push-server run .`).
build:
	@./scripts/build.sh

# In-process Go tests (no Docker needed; covers tenant-isolation + protocol contracts).
unittest:
	go -C event-server test ./... -count=1 -timeout 60s

# Bring up the observability stack (grafana/loki/tempo/mimir/otel-collector). Optional.
obsup:
	docker compose -f {{OBSERVABILITY_COMPOSE}} up -d --wait

# Tear down the observability stack.
obsdown:
	docker compose -f {{OBSERVABILITY_COMPOSE}} down

# Bring up the full dev stack (builds from your checkout, Keycloak + auth on). Pass BUILD=true to force a rebuild.
# Fail fast naming the fix rather than letting Docker report a bare
# "port is already allocated".
check-ports:
	@./scripts/check-ports.sh

up: gen-compose check-ports
	KEYCLOAK_PORT={{KEYCLOAK_PORT}} OAUTH_ISSUER_BASE="{{KEYCLOAK_HOST}}" \
	OAUTH_INTROSPECTION_URLS="{{AUTH_INTROSPECTION_URLS}}" \
		{{COMPOSE}} --profile auth up -d --wait --wait-timeout 300
	@echo "stack up{{if BUILD != '' { ' (rebuilt)' } else { '' }}}; nginx on http://localhost:9090 — see README for hostname routing"

# Tear down the dev stack. Volumes are preserved — use `just clean` to drop them too.
down:
	{{COMPOSE}} --profile auth down

# Run the walkthrough in non-interactive mode against the running docker stack.
test:
	go -C walkthrough run . --non-interactive

# Clean slate (run ONCE before the demo): WIPE backend data, rebuild images, restart everything, open Keycloak + Grafana. Wiping the DB is deliberate — schema changes ship "fresh deploys only" (no migrations), so a stale volume can crash event-server on AutoMigrate.
predemo: gen-compose
	@COMPOSE="{{COMPOSE}}" OBSERVABILITY_COMPOSE={{OBSERVABILITY_COMPOSE}} AUTH_INTROSPECTION_URLS="{{AUTH_INTROSPECTION_URLS}}" bash predemo.sh

# Run the walkthrough interactively against the running stack.
demo:
	go -C walkthrough run . --tui

# Regenerate WALKTHROUGH.md from walkthrough/walkthrough.go.
readme:
	go -C walkthrough run . --doc=md > WALKTHROUGH.md

# Acquire a bearer token via Keycloak browser auth. TENANT=A|B|C. Prints ONLY the access token so `$(just newtoken TENANT=A)` captures cleanly.
newtoken:
	@./scripts/newtoken.sh browser

# Acquire a bearer token via ROPC (CI / scripting). TENANT=A|B|C USER=alice PASSWORD=alice.
newtoken-ci:
	@./scripts/newtoken.sh password

# Long-running poll subscriber. TENANT=A|B|C plus either TOKEN=<bearer> or USERNAME=<u> [PASSWORD=<p>; defaults to USERNAME]. Resume knob: START_CURSOR=<N> (default 0 = replay from buffer head).
poller:
	@./scripts/subscriber.sh poller

# Long-running webhook subscriber. TENANT=A|B|C plus either TOKEN=<bearer> or USERNAME=<u> [PASSWORD=<p>; defaults to USERNAME]. Demo knobs: TTL_MS=<int|null> REPLY_STATUS=<int> EXIT_AFTER=<int>.
webhook:
	@./scripts/subscriber.sh webhook

# Long-running events/stream subscriber over the stateless wire (push delivery). TENANT=A|B|C plus either TOKEN=<bearer> or USERNAME=<u> [PASSWORD=<p>; defaults to USERNAME].
streamer:
	@./scripts/subscriber.sh streamer

# Synthetic chat.message producer. EVERY=2s (default), TENANTS=asgard,babylon,camelot.
drive-chat:
	go -C drivers/synth run . --event chat.message --tenants {{TENANTS}} {{if EVERY != '' { '--every ' + EVERY } else { '' }}}

# Synthetic presence.changed producer. EVERY=5s (default), TENANTS=asgard,babylon,camelot.
drive-presence:
	go -C drivers/synth run . --event presence.changed --tenants {{TENANTS}} {{if EVERY != '' { '--every ' + EVERY } else { '' }}}

# Register a real Discord source on specified replicas. TOKEN=... CHANNELS=A,B REPLICAS=1,4 [TENANTS=a,c] [NAME=discord.message].
add-discord:
	@./scripts/evctl-source.sh add-discord

# Remove a runtime-added source. SOURCE=<name> REPLICAS=<idx,idx>.
rm-source:
	@./scripts/evctl-source.sh rm

# List sources known to a replica. REPLICAS=<idx>.
list-sources:
	go -C evctl run . sources list --replicas={{REPLICAS}}

# macOS+iTerm2 only — open a 2x3 grid: row1 = pollers A/B/C, row2 = webhooks A/B/C.
iterm:
	@bash ./iterm-6up.sh

# macOS+iTerm2 only — open one iTerm window with 3 vertically-stacked panes tailing backends / observability / events logs.
alllogs:
	@bash ./iterm-logs.sh

# Sign out every USER session in all 3 tenant realms (keeps mcp-event-server client creds intact).
clear_all_tokens:
	@./scripts/clear-all-tokens.sh

# Quick clean slate without a full predemo: sign out Keycloak sessions + delete Redis quota keys + truncate webhooks. Survivors of Ctrl+C from prior demo runs (counters/subs that didn't release cleanly) get wiped so the cap=3 quota resets and stale callback URLs disappear. Heavier hammer if needed: `just clean`.
clear-all: clear_all_tokens
	#!/usr/bin/env bash
	set -eu
	deleted=$({{COMPOSE}} exec -T redis sh -c 'redis-cli --scan --pattern "mcpkit.events.quota.*" | xargs -r redis-cli DEL' 2>/dev/null || echo 0)
	echo "[clear-all] redis quota keys deleted: $deleted"
	{{COMPOSE}} exec -T postgres psql -U postgres -d events -c "TRUNCATE TABLE webhooks" >/dev/null 2>&1 && \
		echo "[clear-all] webhooks table truncated" || \
		echo "[clear-all] webhooks table not present yet (no subs ever created) — skip"

# Inject one event from the host. TENANT=A|B|C [EVENT=chat.message] [TEXT="..."].
inject:
	@./scripts/inject.sh

# Tail logs from all services.
logs:
	{{COMPOSE}} logs -f --tail=200

# Show stack containers.
ps:
	{{COMPOSE}} ps

# Print the webhooks table from Postgres — used by the no-expiry restart-survival beat to confirm rows survive a `just restart-event-servers`.
psql-webhooks:
	{{COMPOSE}} exec -T postgres \
		psql -U postgres -d events \
		-c "SELECT id, principal, url, expires_at, status_failing_continuously_since FROM webhooks ORDER BY principal;"

# Rolling-restart the event-server replicas. Used by the no-expiry restart-survival beat — finite subs and no-expiry subs both survive (rows stay in Postgres), proving the GORM-backed WebhookStore is the durability backbone. Replica set is discovered from compose, so it tracks whatever N the stack was generated with.
restart-event-servers:
	#!/usr/bin/env bash
	set -eu
	svcs=$({{COMPOSE}} config --services | grep '^event-server-')
	echo "[restart-event-servers] restarting: $svcs"
	{{COMPOSE}} restart $svcs
	KEYCLOAK_PORT={{KEYCLOAK_PORT}} OAUTH_ISSUER_BASE="{{KEYCLOAK_HOST}}" \
	OAUTH_INTROSPECTION_URLS="{{AUTH_INTROSPECTION_URLS}}" \
		{{COMPOSE}} --profile auth up -d --wait --wait-timeout 300

# Tear down the dev stack AND drop its postgres/redis volumes + built binaries. This IS the full reset now.
clean:
	{{COMPOSE}} --profile auth down -v 2>/dev/null || true
	rm -rf bin/

# Wipe the SHARED docker/backends data. NOT needed for events any more — this only affects examples/agents.
clean-backends:
	RUNNER=just ./scripts/clean-backends.sh

# Append *.whole-enchilada hostnames to /etc/hosts (idempotent).
hosts-install:
	@./scripts/hosts-install.sh

# Remove the whole-enchilada /etc/hosts entries.
hosts-uninstall:
	@sudo sed -i.bak '/whole-enchilada hostnames/,+1 d' /etc/hosts && rm -f /etc/hosts.bak
	@echo "[hosts] uninstalled"
