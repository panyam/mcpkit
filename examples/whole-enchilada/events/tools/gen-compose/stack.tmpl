# GENERATED by tools/gen-compose. DO NOT EDIT.
# Regenerate via `make gen-compose [N=<n>]` (default N=3).
#
# events-stack.yaml — the ONE canonical whole-enchilada events stack.
#
# Self-contained on purpose: every image is pulled, the nginx config is
# inlined as a compose `config`, and state lives in named volumes. Nothing is
# bind-mounted and nothing is built, so the file works when curl'd on its own
# by someone who does not have this repo:
#
#   curl -O https://raw.githubusercontent.com/panyam/mcpkit/main/examples/whole-enchilada/events/events-stack.yaml
#   docker compose -f events-stack.yaml up
#
# Requires Compose v2.23+ for inline `configs:` content.
#
# Developing on it? `make up` layers compose.dev.yaml over this file, which
# swaps the pulled images for builds off your checkout and publishes the
# database ports. One stack definition, two entry points. There used to be a
# second hand-maintained compose here and it had already drifted on five
# environment variables within days of being written.
#
# Default posture:
#   nginx (:9090) -> {{.N}} round-robin event-server replicas
#   postgres      -> durable WebhookStore + EventBufferStore
#   redis         -> cross-replica event fanout + global subscription caps
#   auth          -> anonymous. Every caller is `demo-principal`.
#
# `--profile auth` adds Keycloak (:8180, override with KEYCLOAK_PORT) with three
# tenant realms. It does NOT
# switch the replicas onto it by itself: OAUTH_INTROSPECTION_URLS has to be set
# too, which `make stack-up-auth` does. Starting an identity provider that
# nothing consults is a mistake this stack has already shipped once.
#
# The interactive subscriber tools (`make webhook`, `make streamer`,
# `make poller`) are host processes from a checkout. This file gives you a
# server to point your OWN MCP client at.
#
# DNS convention, inside the compose network:
#   nginx.whole-enchilada            — frontdoor (port 80)
#   event-server.whole-enchilada     — round-robin to all replicas
#   event-server-<i>.whole-enchilada — direct pin to replica i (1..N)

name: mcpkit-events

configs:
  nginx_conf:
    content: |
{{.NginxConf}}

volumes:
  postgres_data:
  redis_data:

networks:
  # No literal `name:`, so Compose namespaces this per project. That is what
  # keeps the stack from colliding with the shared `mcpkit` network that
  # docker/backends and docker/observability fight over. compose.dev.yaml adds
  # that shared network back when you need the collector.
  whole-enchilada:
    driver: bridge

services:
  postgres:
    image: pgvector/pgvector:pg18
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: events
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d events"]
      interval: 3s
      timeout: 2s
      retries: 20
    volumes:
      - postgres_data:/var/lib/postgresql
    networks:
      whole-enchilada:
        aliases:
          - postgres

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--dir", "/data"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 3s
      timeout: 1s
      retries: 10
    volumes:
      - redis_data:/data
    networks:
      whole-enchilada:
        aliases:
          - redis

  keycloak:
    image: {{.KeycloakImage}}
    profiles: ["auth"]
    restart: unless-stopped
    command: ["start-dev", "--http-port=8080", "--import-realm"]
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
      KC_HTTP_RELATIVE_PATH: /
      # Must match the published port below: Keycloak stamps this into the
      # `iss` claim, and event-server rejects a token whose issuer does not
      # equal OAUTH_ISSUER_BASE + "/realms/" + <realm> exactly.
      KC_HOSTNAME: http://localhost:${KEYCLOAK_PORT:-8180}
      KC_HOSTNAME_STRICT: "false"
    ports:
      # 8180 by default, which every documented token recipe assumes. Override
      # KEYCLOAK_PORT when docker/backends is also up, since it publishes a
      # Keycloak on the same port for examples/agents. Postgres and Redis are
      # already offset to 5433/6380 by the dev overlay for the same reason.
      - "${KEYCLOAK_PORT:-8180}:8080"
    healthcheck:
      # Probes camelot, the last realm imported alphabetically, so a 200 here
      # means all three are live.
      test:
        - CMD-SHELL
        - "exec 3<>/dev/tcp/localhost/8080 && printf 'GET /realms/camelot/.well-known/openid-configuration HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 && head -c 64 <&3 | grep -q '200 OK'"
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 30s
    networks:
      whole-enchilada:
        aliases:
          - keycloak

  nginx:
    image: nginx:1.27-alpine
    ports:
      - "9090:80"
    configs:
      - source: nginx_conf
        target: /etc/nginx/nginx.conf
    networks:
      whole-enchilada:
        aliases:
          - nginx.whole-enchilada
    depends_on:
{{range .EventServers}}      - event-server-{{.}}
{{end}}
{{range .EventServers}}
  event-server-{{.}}:
    image: {{$.Image}}
    restart: unless-stopped
    # Lets the event-server reach webhook receivers running on the
    # host (e.g. `make webhook` opens a listener on the operator's
    # 127.0.0.1:<dynamic-port>). Docker Desktop on macOS/Windows
    # auto-maps host.docker.internal; Linux needs the explicit
    # host-gateway entry. The webhook binary rewrites its callback
    # URL from 127.0.0.1 → host.docker.internal so this entry is
    # what makes that URL resolvable from inside the container.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      # Stamped on every HTTP response (X-Replica header) and every
      # outbound webhook POST so the multi-replica walkthrough beat
      # can show round-robin rotation + which replica fanned out each
      # webhook. Falls back to os.Hostname() if unset, but compose's
      # default short-hash hostname isn't operator-readable — set
      # explicitly per replica.
      REPLICA_NAME: event-server-{{.}}
      EVENT_INJECT_BEARER: ${EVENT_INJECT_BEARER:-{{$.InjectBearer}}}
      # Stage-2: introspection-mode auth. The event-server's
      # tryEnableIntrospection reads OAUTH_INTROSPECTION_URLS as a
      # comma-separated list of N introspection endpoints and wires a
      # MultiIntrospectionValidator that accepts a token if ANY realm's
      # introspection endpoint returns active=true. Shared client_id /
      # client_secret across all realms (DEMO ONLY — production would
      # register a distinct client per realm).
      # Empty selects the anonymous posture. `make stack-up-auth` sets this to
      # the three realm introspection endpoints, which also changes the
      # container config and forces the recreate that switches the replica over.
      OAUTH_INTROSPECTION_URLS: ${OAUTH_INTROSPECTION_URLS:-}
      OAUTH_CLIENT_ID: ${OAUTH_CLIENT_ID:-mcp-event-server}
      OAUTH_CLIENT_SECRET: ${OAUTH_CLIENT_SECRET:-{{$.KCResourceSecret}}}
      OAUTH_CACHE_TTL: ${OAUTH_CACHE_TTL:-5s}
      # OAUTH_ISSUER_BASE is the PUBLIC scheme://host:port that
      # appears in token iss claims — same value KC_HOSTNAME is set
      # to on the keycloak service in docker/backends. The BCL
      # receiver expects iss = OAUTH_ISSUER_BASE + "/realms/" + <realm>
      # exactly.
      # Flat default on purpose. A nested ${...} inside a default value is
      # fragile across Compose versions, so when KEYCLOAK_PORT moves this must
      # move with it. The Makefile exports both together; a raw `docker compose`
      # with a custom KEYCLOAK_PORT has to set OAUTH_ISSUER_BASE too, or tokens
      # carry an `iss` the replicas will reject.
      OAUTH_ISSUER_BASE: ${OAUTH_ISSUER_BASE:-http://localhost:8180}
      # OTel telemetry. EXPORTER=auto means "best-effort OTLP with
      # silent Noop fallback" — works whether docker/observability is
      # up or not. To force OTLP and fail loudly when the collector
      # is missing, set EXPORTER=otlp in the host shell before
      # docker compose up.
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
      # Redis backend (issues 634 + 718). When REDIS_ADDR is set,
      # event-server's configureRedisBackend swaps the in-memory
      # QuotaStore + LocalEmitter defaults for Redis-backed
      # counterparts (Pattern B: Publisher is the sole outbound sink;
      # Subscriber delivers to LOCAL on every replica). This is what
      # makes the multi-replica push-survival demo actually work —
      # without it, each replica maintains its own subscription
      # counts and fans out only locally. Resolves to docker/backends
      # via the shared mcpkit network.
      REDIS_ADDR: ${REDIS_ADDR:-redis:6379}
      # Postgres backend (issue 639). When POSTGRES_DSN is set,
      # event-server's configurePostgresBackend swaps the in-memory
      # WebhookStore default for the gorm-backed Postgres impl —
      # webhook subscriptions survive replica restarts and live in a
      # single source of truth across replicas. Resolves to
      # docker/backends via the shared mcpkit network.
      POSTGRES_DSN: ${POSTGRES_DSN:-postgres://postgres:postgres@postgres:5432/events?sslmode=disable}
      # Per-event-type subscription caps. Format:
      # EVENTS_QUOTA_CAPS=<eventName>=<int>[,<eventName>=<int>...]
      # When set, event-server constructs Quota with
      # WithMaxSubscriptionsPerPrincipal(name, n) per entry. Cross-
      # replica enforcement comes from the Redis-backed QuotaStore
      # (issue 718); a 4th subscribe for the same principal lands on
      # any replica → -32013 ResourceExhausted with the
      # {limit:"subscriptions", max:N} envelope.
      # Default chat.message=10 gives operating headroom for normal
      # demo play (3 streamers + 3 webhooks + some accumulated Ctrl+C
      # remnants stay well under cap). The Phase 6 walkthrough beat
      # overrides this down to 3 via EVENTS_QUOTA_CAPS=chat.message=3
      # for its "subscribe 4 times, watch the 4th fail" demonstration.
      EVENTS_QUOTA_CAPS: ${EVENTS_QUOTA_CAPS:-chat.message=10}
      # EVENTS_ALLOW_INFINITE_TTL=true opts the registry into accepting
      # `ttlMs: null` requests + returning `refreshBefore: null` (PR 779,
      # spec PR1 commit 99f3589c §"Subscription TTL"). Default ON in
      # this demo so the TTL-negotiation + no-expiry walkthrough beats
      # work out of the box. Production deployments leave this OFF
      # unless they've also wired a durable WebhookStore (we have —
      # POSTGRES_DSN above) AND accepted the failure-based GC obligations.
      EVENTS_ALLOW_INFINITE_TTL: ${EVENTS_ALLOW_INFINITE_TTL:-true}
      # EVENTS_NO_EXPIRY_GC_WINDOW tightens the failure-based GC clock
      # for no-expiry subscriptions (PR 783). Library default is 72h
      # (DefaultNoExpiryFailureGCWindow) — invisible in a 30-min demo;
      # 2m makes the end-to-end "subscriber dies, server drops the no-
      # expiry sub after sustained delivery failure" beat observable.
      # Production deployments leave this at the default (or longer).
      EVENTS_NO_EXPIRY_GC_WINDOW: ${EVENTS_NO_EXPIRY_GC_WINDOW:-2m}
      # POSTGRES_BUFFER_TTL — retention window for Postgres-backed
      # EventBufferStore rows (issue 727). The background sweeper drops
      # rows past expires_at every 60s; clients polling for an evicted
      # cursor get truncated:true back. 10m for the demo so the
      # "stale cursor truncates" walkthrough beat doesn't need an hour
      # of patience.
      POSTGRES_BUFFER_TTL: ${POSTGRES_BUFFER_TTL:-10m}
      # EVENTS_STORE_MINT_CURSORS — cross-replica cursor consistency
      # (issue 833). On by default: the Postgres buffer store assigns each
      # event's cursor from its own write sequence, so the N replicas
      # writing chat.message (round-robined by `make inject`) get globally
      # monotone, collision-free cursors and events/poll resume is gap-free
      # across replicas. Set to false to fall back to per-replica in-process
      # counters and watch the collision (cursor "5" minted on every
      # replica) — the teaching contrast for the walkthrough.
      EVENTS_STORE_MINT_CURSORS: ${EVENTS_STORE_MINT_CURSORS:-true}
    # `--exporter=auto` means best-effort OTLP with Noop fallback when
    # the collector is unreachable. common.RegisterTelemetryFlags
    # doesn't read EXPORTER from env, so we wire it via the CLI flag;
    # operators override with `EXPORTER=otlp make up` for fail-loud.
    command: ["-addr", ":8080", "--exporter=${EXPORTER:-auto}", "--otlp-endpoint=${OTEL_EXPORTER_OTLP_ENDPOINT:-}"]
    expose:
      - "8080"
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:8080/healthz"]
      interval: 5s
      timeout: 2s
      retries: 5
    depends_on:
{{if ne . 1}}      # Replica 1 creates the schema on first boot. Concurrent AutoMigrate from
      # N replicas against an empty DB races on Postgres catalog creates
      # (pg_type, SQLSTATE 23505) and kills the losers, so 2..N wait for it.
      event-server-1:
        condition: service_healthy
{{end}}      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      whole-enchilada:
        aliases:
          - event-server.whole-enchilada
          - event-server-{{.}}.whole-enchilada
{{end}}
