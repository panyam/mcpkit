# Run the demokit walkthrough (interactive, TUI). Server must be up via `just serve` in another terminal.
demo:
    go run . --tui

# Run the walkthrough in notebook mode (Bubble Tea cells)
note:
    go run . --note

# Start the fixture server (200 tools + 2 skills on :8080)
serve:
    go run . --serve

# Run the exercise checks against a running server (URL=http://localhost:8080)
check URL="http://localhost:8080":
    go run . --check --url {{URL}}

# Run the plain-client checks on both wires
test:
    go test ./... -count=1

# Regenerate WALKTHROUGH.md from demo definitions
readme:
    go run . --doc md > WALKTHROUGH.md

# Build the binary
build:
    go build -o disclosure-demo .

default: demo
