# examples/apps/any-frontend — recipe bodies live in scripts/*.sh (C8).

# Start the server on :8080 (open http://localhost:8080/host)
run:
    go run .

serve: run

# Go unit tests
test:
    go test ./...

# Rebuild views/*.html from web/ (requires pnpm + Node)
build-views:
    @bash scripts/build-views.sh

# Typecheck web/ and fail if views/*.html are stale
check-views:
    @bash scripts/check-views.sh

# Drive all four Views in Chromium through /host
test-e2e:
    @bash scripts/test-e2e.sh
