# Run the demokit walkthrough (interactive, TUI)
demo:
    go run . --tui

# Run the walkthrough in notebook mode (Bubble Tea cells)
note:
    go run . --note

# Start the agents discovery server (default :8080)
serve:
    go run . --serve

# Regenerate WALKTHROUGH.md from demo definitions
readme:
    go run . --doc md > WALKTHROUGH.md

# Build the binary
build:
    go build -o agents-discovery .

# Run the walkthrough's claims on both wires
test:
    go test ./... -count=1 -timeout 60s

default: demo
